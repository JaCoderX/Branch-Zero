# secrets — all .env* stay local (desk-only files included)
.env
.env.*
!.env.example
# explicit: Live Docker desk env (TELLER_ENV_FILE=.env.teller-live) — never commit
.env.teller-live
.env.teller-*
# explicit: Cloudflare Pages / shell build env mirror (public VITE_* only) — never commit
.env.web-live
.env.web-*
*.pem
*.key
*.p12
*.jks
*.secret
credentials*.json
secrets*.json

# teller desk local player index (dev only, no secrets — but per-machine)
apps/teller-desk/.data/

# node
node_modules/
dist/
.turbo/
.wrangler/

# godot
.godot/
*.translation
*.tmp

# exports / binaries
*.pck
*.wasm
*.exe
apps/web/public/game/

# os
Thumbs.db
.DS_Store
.vscode/
.idea/

# infra build output (compiled artifacts + fetched template source) — re-created by `npm run chain:compile`
infra/build/

# godot web export lands here; regenerate with `npm run export:web`
apps/web/public/game/

# vite
apps/web/dist/
*.local

# agent scratch probes (never committed)
.scratch/

# ---- hackathon public surface ----
# Product code, handoffs, and kickoffs stay public.
# Daily construction evidence stays on the laptop.

# Daily unit notes, captures, probe logs, demo reels
docs/progress/

# Cursor / Claude local launch configs
.claude/

# Large media anywhere (demo reels, exports)
*.mp4
*.mkv
*.webm

# ENG-2026-0025 custom Godot web export template (7.3 MB binary, pinned by sha256 in tools/godot-web-template/SHA256SUMS)
tools/godot-web-template/*.zip
