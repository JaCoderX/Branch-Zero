apps/web/public/game/

# vite
apps/web/dist/
*.local

# agent scratch probes (never committed)
.scratch/

# ---- agent / media hygiene ----
# Keep HANDOFF / KICKOFF / progress markdown tracked for cold-agent kickoffs.
# Ignore only binary captures and local agent launch configs.

docs/progress/captures/*
!docs/progress/captures/README.md

.claude/

# Large media anywhere (demo reels, exports)
*.mp4
*.mkv
*.webm
