# Cloudflare Pages response headers for the Branch Zero shell (docs/HOSTING.md section 3).
#
# Deliberately NO Cross-Origin-Opener-Policy / Cross-Origin-Embedder-Policy anywhere: the Godot export is
# single-threaded (no SharedArrayBuffer) and COEP `require-corp` would break the Privy iframe (docs/GODOT.md).
# Do not add them "for performance".

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# The Godot export (lean Profile H on Workers). Do not long-cache: a redeploy must win over the previous
# index.pck / wasm within one refresh (unicorn facing, bank wipe recovery). Hashless filenames.
/game/*.wasm
  Content-Type: application/wasm
  Cache-Control: no-cache

/game/*.pck
  Content-Type: application/octet-stream
  Cache-Control: no-cache

/game/*.js
  Cache-Control: no-cache

# Vite emits hashed filenames under /assets - safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shell itself must always be re-checked so a redeploy is picked up.
/index.html
  Cache-Control: no-cache
