{
  "name": "@branch-zero/teller-desk",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Teller Desk service (Fastify). U1: Privy session-signer signing lane, CopyBlox provisioning, Lane A payments. U2: time-locked wires (Lane B), owner transactions via session signer, Branch Manager role.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "killtests": "tsx --env-file-if-exists=../../.env scripts/kill-tests.ts",
    "killtests:u2": "tsx --env-file-if-exists=../../.env scripts/kill-tests-u2.ts"
  },
  "dependencies": {
    "@bloxchain/sdk": "1.0.0",
    "@branch-zero/shared": "*",
    "@privy-io/node": "^0.34.0",
    "fastify": "^5.1.0",
    "viem": "2.50.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
