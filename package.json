{
  "name": "branch-zero",
  "private": true,
  "version": "0.0.1",
  "description": "Branch Zero — a walkable 3D bank where every desk is a real Bloxchain account operation (ETHOnline 2026)",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/teller-desk",
    "infra"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "npm -w apps/web run dev",
    "dev:teller": "npm -w apps/teller-desk run dev",
    "killtests": "npm -w apps/teller-desk run killtests --",
    "build:web": "npm -w apps/web run build",
    "export:web": "node scripts/export-web.mjs",
    "chain:probe": "npm -w infra run probe",
    "chain:bootstrap": "npm -w infra run bootstrap --",
    "chain:compile": "npm -w infra run compile",
    "chain:deploy": "npm -w infra run deploy",
    "chain:smoke": "npm -w infra run smoke",
    "typecheck": "npm -w packages/shared run typecheck && npm -w infra run typecheck && npm -w apps/web run typecheck && npm -w apps/teller-desk run typecheck",
    "killtests:s1": "npm -w apps/teller-desk run killtests:s1 --",
    "fx:pool": "npm -w infra run fx:pool --",
    "dev:teller:dev": "npm -w apps/teller-desk run dev:dev",
    "funding:sepolia": "npm -w infra run funding:sepolia",
    "killtests:s2": "npm -w apps/teller-desk run killtests:s2 --",
    "treasury:topup": "npm -w apps/teller-desk run treasury:topup --",
    "killtests:treasury": "npm -w apps/teller-desk run killtests:treasury --"
  }
}
