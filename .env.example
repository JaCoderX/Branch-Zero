# Branch Zero — environment variable NAMES only. Copy to .env (git-ignored) and fill locally.
# Never commit real keys. Remote EVM (chain 1337) uses Ganache-parity keys that MUST NEVER touch a public network.

# ---- chains ----
CHAIN_ID=1337
REMOTE_EVM_RPC_URL=http://127.0.0.1:8545
# Tailscale Serve alternative (hostname stays local, never committed):
# REMOTE_EVM_RPC_URL=https://<host>.<tailnet>.ts.net
SEPOLIA_RPC_URL=
ARC_RPC_URL=https://rpc.testnet.arc.io

# ---- keys (infra/ + Teller Desk) ----
# Remote EVM dev mapping (docs/REMOTE-EVM.md §2): deployer=acct0, broadcaster=acct1, recovery=acct2, manager=acct3, player owner=acct4.
# Private keys live in particle-tool-box/Docker Apps/Remote EVM/ganache-deterministic-accounts.json — paste locally, never here.
DEPLOYER_PK=
BROADCASTER_PK=
MANAGER_PK=
# Arc Testnet (5042002) keys are separate from every Remote EVM / ENS key. Never paste Ganache-parity keys here.
ARC_DEPLOYER_PK=
ARC_BROADCASTER_PK=
ARC_MANAGER_PK=
# Addresses (public) used by scripts when no key is needed:
OWNER_ADDRESS=0xd03ea8624C8C5987235048901fB614fDcA89b117
BROADCASTER_ADDRESS=0xFFcf8FDEE72ac11b5c542428B35EEF5769C409f0
RECOVERY_ADDRESS=0x22d491Bde2303f2f43325b2108D26f1eAbA1e32b
ARC_OWNER_ADDRESS=
ARC_BROADCASTER_ADDRESS=
ARC_RECOVERY_ADDRESS=

# ---- account params ----
TIMELOCK_SEC=120
# Opening balance handed to a freshly provisioned account, in display units of the demo token.
OPENING_BALANCE_USDC=500
# Lane A soft cap (off-chain routing only; see docs/REFLECTION.md 2.2). Above this it is a wire (Lane B, U2).
INSTANT_LIMIT_USDC=100
# U2 Lane B option 1: the player's embedded wallet sends executeWithTimeLock / approve / cancel itself, so it
# needs gas. The deployer tops it up to this amount at Account Opening (native units; Arc native USDC is 18 decimals).
OWNER_GAS_ETH=0.05
# U4+ Priority release (G5b). on = Mr. Okafor may submit an owner-signed meta-approve BEFORE releaseTime once the
# player passes a Passkey (hand scan); needs MANAGER_PK. off = vault-only accounts (U2 invariant: no META_APPROVE
# bits on transfer, the clock is the only way out). Default: on when MANAGER_PK is set. Re-check re-syncs grants.
PRIORITY_RELEASE=on
EVENT_FORWARDER=0x0000000000000000000000000000000000000000

# ---- one-time chain bootstrap (npm run chain:bootstrap) ----
# Path to a BUILT Bloxchain-Protocol checkout. Read only for already-compiled artifact JSON (CopyBlox,
# BasicERC20), which is deployed unchanged and recorded in infra/deployments/. Nothing in apps/ uses it.
BLOXCHAIN_PROTOCOL_DIR=

# ---- historical U0 compiler (not the ongoing product path) ----
# SOLC_EVM_VERSION=prague

# ---- teller desk ----
PORT=8787
# Run a second Teller Desk with CHAIN_ID=5042002 and PORT=8788 for the Arc wing.
ALLOWED_ORIGINS=http://localhost:5173
VITE_TELLER_DESK_URL=/api
VITE_ARC_TELLER_DESK_URL=/arc-api

# ---- privy (U1) — app created; fill remaining secrets locally ----
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
PRIVY_POLICY_ID=
PRIVY_SIGNER_ID=

# ---- web (Vite, prefixed) ----
# VITE_PRIVY_APP_ID must match PRIVY_APP_ID; VITE_PRIVY_SIGNER_ID must match PRIVY_SIGNER_ID.
# Never put PRIVY_APP_SECRET or PRIVY_AUTHORIZATION_KEY in VITE_* vars.
VITE_PRIVY_APP_ID=
VITE_PRIVY_SIGNER_ID=
# Leave empty in dev: the overlay then calls same-origin '/api', which Vite proxies to the Teller Desk.

# ---- ENS (U5 / ENG-0007) — Sepolia only; never Ganache or mainnet keys ----
# Parent branchzero.eth is registered on ENSv2 (K6 yes). Pin UR V2 0x85ed…b92cf in desk resolve code.
# Customers UserRegistry 0x64ED…073c — see GameLab ENG-0007 handoff / infra/deployments/sepolia.json.
# ENS_REGISTRAR_PK = Sepolia throwaway (fund ETH; MockUSDC is permissionless mint on 0xd332…422f).
ENS_PARENT_NAME=branchzero.eth
ENS_REGISTRAR_PK=
