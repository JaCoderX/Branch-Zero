# Branch Zero — environment variable NAMES only. Copy to .env (git-ignored) and fill locally.
# Never commit real keys. Remote EVM (chain 1337) uses Ganache-parity keys that MUST NEVER touch a public network.

# ---- chains ----
REMOTE_EVM_RPC_URL=http://127.0.0.1:8545
# Tailscale Serve alternative (hostname stays local, never committed):
# REMOTE_EVM_RPC_URL=https://<host>.<tailnet>.ts.net
SEPOLIA_RPC_URL=
ARC_RPC_URL=https://rpc.testnet.arc.io

# ---- keys (infra/ + Teller Desk) ----
# Remote EVM dev mapping (docs/REMOTE-EVM.md §2): deployer=acct0, broadcaster=acct1, recovery=acct2, manager=acct3, player owner=acct4.
# Private keys live in particle-tool-box/Docker Apps/Remote EVM/ganache-deterministic-accounts.json — paste locally, never here.
DEPLOYER_PK=
BROADCASTER_PK=
MANAGER_PK=
# Addresses (public) used by scripts when no key is needed:
OWNER_ADDRESS=0xd03ea8624C8C5987235048901fB614fDcA89b117
BROADCASTER_ADDRESS=0xFFcf8FDEE72ac11b5c542428B35EEF5769C409f0
RECOVERY_ADDRESS=0x22d491Bde2303f2f43325b2108D26f1eAbA1e32b

# ---- account params ----
TIMELOCK_SEC=120
EVENT_FORWARDER=0x0000000000000000000000000000000000000000

# ---- compiler (infra/scripts/compile.ts) ----
# Remote EVM chainspec activates forks through Prague (no Osaka). Upstream compiles for osaka; we target prague on 1337.
SOLC_EVM_VERSION=prague

# ---- teller desk ----
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173

# ---- privy (U1, not used in U0) ----
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY=
PRIVY_POLICY_ID=

# ---- web (Vite, prefixed) ----
VITE_TELLER_DESK_URL=http://localhost:8787
