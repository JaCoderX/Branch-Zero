{
  "name": "@branch-zero/infra",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Deploy scripts: compile published @bloxchain/contracts sources and deploy AccountBlox on Remote EVM / testnets. Addresses only in deployments/.",
  "scripts": {
    "probe": "tsx scripts/probe.ts",
    "compile": "tsx scripts/compile.ts",
    "deploy": "tsx scripts/deploy-account.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json",
    "bootstrap": "tsx scripts/bootstrap-blox.ts"
  },
  "dependencies": {
    "@bloxchain/sdk": "1.0.0",
    "@branch-zero/shared": "*",
    "viem": "2.50.4"
  },
  "devDependencies": {
    "@bloxchain/contracts": "1.0.0",
    "@types/node": "^22.0.0",
    "solc": "0.8.35",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
